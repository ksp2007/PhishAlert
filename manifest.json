{
  "manifest_version": 3,
  "name": "PhishAlert",
  "version": "2.5.0",
  "description": "Phishing protection for Gmail, Outlook, Yahoo & ProtonMail: scans emails and links with threat intel, DNS and header checks.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "webNavigation"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://mail.yahoo.com/*",
    "https://mail.proton.me/*",
    "https://app.protonmail.ch/*",
    "https://dns.google/*",
    "https://rdap.org/*",
    "https://www.virustotal.com/*",
    "https://urlhaus-api.abuse.ch/*",
    "https://checkurl.phishtank.com/*",
    "https://openphish.com/*",
    "https://unshorten.me/*",
    "https://expandurl.net/*",
    "https://api.groq.com/*",
    "https://api.xposedornot.com/*",
    "https://safebrowsing.googleapis.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://phishalert-canary.phishalert-canary.workers.dev/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "jsQR.js",
        "psl.js",
        "idn.js",
        "content-shared.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ],
      "js": [
        "psl.js",
        "idn.js",
        "content-shared.js",
        "content-outlook.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.yahoo.com/*"
      ],
      "js": [
        "psl.js",
        "idn.js",
        "content-shared.js",
        "content-yahoo.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.proton.me/*",
        "https://app.protonmail.ch/*"
      ],
      "js": [
        "psl.js",
        "idn.js",
        "content-shared.js",
        "content-proton.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open PhishAlert quick scan"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://mail.yahoo.com/*",
        "https://mail.proton.me/*",
        "https://app.protonmail.ch/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}